# ---- Database (TiDB Cloud Serverless / MySQL) ----
DB_HOST=gateway01.xxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=service_ticket_system
DB_USER=xxxxxxxx.root
DB_PASSWORD=your-db-password
DB_SSL=true
# Set true in serverless/managed environments (skips CREATE DATABASE on connect)
SKIP_DB_BOOTSTRAP=false

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- CORS (comma-separated allow-list of frontend origins) ----
CORS_ORIGINS=http://localhost:5173,https://service-ticket-system-frontend.vercel.app

# ---- Email / OTP (Gmail) ----
# Gmail address + 16-char App Password. If unset, the OTP is logged and returned
# in the API response so the flow stays testable without email.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16charapppass
# Force-return the OTP in the register response even when email is configured (demo only)
EXPOSE_OTP=false

# ---- Misc ----
NODE_ENV=development
PORT=3000
SERVICE_NAME=service-ticket-system
# Local dev only: auto-seed roles/statuses/demo org on boot
SEED_ON_BOOT=true
