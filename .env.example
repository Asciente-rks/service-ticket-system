# ---- Database (TiDB Cloud Serverless / MySQL) ----
DB_HOST=gateway01.xxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=service_ticket_system
DB_USER=xxxxxxxx.root
DB_PASSWORD=your-db-password
DB_SSL=true
SKIP_DB_BOOTSTRAP=false

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- CORS (comma-separated allow-list of frontend origins) ----
CORS_ORIGINS=http://localhost:5173,https://service-ticket-system-frontend.vercel.app

# ---- Email / OTP (optional; unset => OTP returned in response for demo) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EXPOSE_OTP=false

# ---- Misc ----
NODE_ENV=development
PORT=3000
SERVICE_NAME=service-ticket-system
SEED_ON_BOOT=true
